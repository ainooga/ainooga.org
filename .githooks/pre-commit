#!/usr/bin/env bash
set -euo pipefail

# lint-staged can rewrite the index and working tree. Finish before reading either.
node_modules/.bin/lint-staged
# Check the staged blob, not a possibly different, partially staged working file.
while IFS= read -r -d '' file; do
  case "$file" in
    *.[Jj][Pp][Gg]|*.[Jj][Pp][Ee][Gg]|*.[Pp][Nn][Gg]|*.[Gg][Ii][Ff])
      size=$(git cat-file -s ":$file")
      if (( size > 500 * 1024 )); then
        printf 'Error: staged image %s exceeds 500 KB (%s bytes).\n' "$file" "$size" >&2
        exit 1
      fi ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMRT)
# Bootstrap from the index too: an unstaged fix to the exporter must not pass.
bootstrap=$(git cat-file blob ':scripts/test-index.mjs')
exec node --input-type=module --eval "$bootstrap"
